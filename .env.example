# Copy this file to .env and adjust it for your machine.
#
# Docker is the default for local integration tests.
GEODEPOT_COMPOSE="docker compose"
GEODEPOT_CONTAINER_SOCKET=/var/run/docker.sock
#
# Rootless Podman:
# GEODEPOT_COMPOSE="podman compose"
# GEODEPOT_CONTAINER_SOCKET="${XDG_RUNTIME_DIR}/podman/podman.sock"
#
# When tests run inside a devcontainer, they need to connect to the test server
# through the host. Host-side runs can leave this unset.
# GEODEPOT_TEST_REMOTE_HOST=host.containers.internal
