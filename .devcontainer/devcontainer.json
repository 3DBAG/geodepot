{
    "name": "geodepot",
    "workspaceFolder": "/IdeaProjects/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/IdeaProjects/${localWorkspaceFolderBasename},type=bind,relabel=shared",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "PIXI_VERSION": "v0.68.1"
        }
    },
   
  "customizations" : {
    "jetbrains" : {
      "backend" : "PyCharm"
    }
  },
    "runArgs": [
        "--userns=keep-id"
    ],
    "containerEnv": {
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "GEODEPOT_HOST_WORKSPACE": "${localWorkspaceFolder}",
        "GEODEPOT_TEST_REMOTE_HOST": "host.containers.internal"
    },
    "mounts": [
        "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume",
        "source=${localEnv:GEODEPOT_CONTAINER_SOCKET},target=/var/run/docker.sock,type=bind"
    ],
    "postCreateCommand": "pixi install"
}
