{
    "name": "geodepot",
    "workspaceFolder": "/IdeaProjects/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/IdeaProjects/${localWorkspaceFolderBasename},type=bind,relabel=shared",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "PIXI_VERSION": "v0.68.1"
        }
    },
    "features": {
        "ghcr.io/balazsdukai/devcontainer-tools/tools:1": {}
    },
    "remoteUser": "vscode",
    "containerUser": "vscode",
   
  "customizations" : {
    "jetbrains" : {
      "backend" : "PyCharm"
    }
  },
    "runArgs": [
        "--userns=keep-id"
    ],
    "containerEnv": {
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "GEODEPOT_HOST_WORKSPACE": "${localWorkspaceFolder}",
        "GEODEPOT_TEST_REMOTE_HOST": "host.containers.internal",
        "TOOLS_CONTAINER_HOME": "/home/vscode",
        "SSH_AUTH_SOCK": "/ssh-agent"
    },
    "mounts": [
        "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume",
        "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/var/run/docker.sock,type=bind",
        "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,relabel=shared",
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,relabel=shared",
        "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,relabel=shared",
        "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind,relabel=shared"
    ],
    "remoteEnv": {
        "GH_TOKEN": "${localEnv:GH_TOKEN}"
    },
    "postCreateCommand": "pixi install"
}
